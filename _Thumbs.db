   "source": [
    "#displaying failed and successful jobs in different clusters\n",
    "success = dataset.loc[dataset['failed'] == 0]\n",
    "failed = dataset.loc[dataset['failed'] == 1]\n",
    "success = success.groupby(['cluster'])['failed'].count().reset_index(name=\"Successful Jobs\")\n",
    "failed = failed.groupby(['cluster'])['failed'].count().reset_index(name=\"Failed Jobs\")\n",
    "success['Failed Jobs'] = failed['Failed Jobs']\n",
    "success"
   ]
  },
