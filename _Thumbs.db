   "source": [
    "#Type of customers who is cancelling most tickets\n",
    "labels, count = np.unique(dataset['failed'], return_counts=True)\n",
    "labels = ['Success', 'Failed']\n",
    "plt.pie(count, labels = labels, autopct='%.0f%%')\n",
    "plt.title(\"Success & Failed Jobs in the Dataset\")\n",
    "plt.show()"
   ]
  },
