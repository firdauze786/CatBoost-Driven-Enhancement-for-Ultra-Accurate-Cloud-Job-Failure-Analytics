    "#visualizing features correlation graph where features with maximum will be conisder as highly related\n",
    "plt.figure(figsize=(12, 8)) # Adjust figure size as needed\n",
    "ax = sns.heatmap(dataset.corr(), annot=True, cmap='coolwarm', fmt=\".2f\", linewidths=.5, vmin=-1, vmax=-1)\n",
    "bottom, top = ax.get_ylim()\n",
    "ax.set_ylim(bottom + 0.5, top - 0.5)\n",
    "plt.title('Features Correlation Heatmap Graph')\n",
    "plt.show()"
   ]
  },
