   ],
   "source": [
    "#shuffling and splitting dataset into train and test\n",
    "X = dataset.values\n",
    "indices = np.arange(X.shape[0])\n",
    "np.random.shuffle(indices)#shuffling the dataset to distribute classes at random position\n",
    "X = X[indices]\n",
    "failed = failed[indices]\n",
    "#split dataset features into train (80% & test (20%)\n",
    "X_train, X_test, y_train, y_test = train_test_split(X, failed, test_size=0.3)\n",
    "print(\"Dataset Train & Test Split Details\")\n",
    "print(\"80% dataset features used to train algorithms : \"+str(X_train.shape[0]))\n",
    "print(\"20% dataset features used to test algorithms : \"+str(X_test.shape[0]))\n",
    "data = np.load(\"model/data.npy\", allow_pickle=True)\n",
    "X_train, X_test, y_train, y_test = data"
   ]
  },
