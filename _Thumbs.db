   "source": [
    "#creating job failed detection type using probabilities from base estimators and random forest\n",
    "train_prob = ensemble_model.predict_proba(X_train)#getting probabilities from train and test data\n",
    "test_prob = ensemble_model.predict_proba(X_test) \n",
    "train_prob = np.hstack((X_train, train_prob))\n",
    "test_prob = np.hstack((X_test, test_prob))\n",
    "#training random forest with probabilities and model weight values\n",
    "rf_cls = RandomForestClassifier(max_depth=5)\n",
    "rf_cls.fit(train_prob, train_failed_type)\n",
    "predict = rf_cls.predict(test_prob)\n",
    "#call this function to calculate accuracy and other metrics\n",
    "modelEvaluation(\"Random Forest Failed Type\", test_failed_type, predict, 0)"
   ]
  },
