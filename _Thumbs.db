   "source": [
    "#training propose ensemble model using voting classifier\n",
    "#creating list of base estimators\n",
    "estimators = [('dt', dt_cls), ('knn', knn_cls), ('xg', xg_cls), ('ada', ada_cls), ('ann', ann_cls)]\n",
    "#creating voting classifier\n",
    "ensemble_model = VotingClassifier(estimators = estimators, voting='soft')\n",
    "#training the model\n",
    "ensemble_model.fit(X_train, y_train)\n",
    "predict = ensemble_model.predict(X_test)\n",
    "#call this function to calculate accuracy and other metrics\n",
    "modelEvaluation(\"Ensemble Model\", y_test, predict, 0)"
   ]
  },
