   "source": [
    "#train grid cv parameters decision tree algorithm on 70% training features and then apply trained model on 30% test to calculate prediction accuracy\n",
    "dt_cls = DecisionTreeClassifier(max_depth=None, min_samples_split = 2, min_weight_fraction_leaf=0.007)\n",
    "#train model on training features\n",
    "dt_cls.fit(X_train, y_train)\n",
    "#call this function to predict on test data\n",
    "predict = dt_cls.predict(X_test)\n",
    "#call this function to calculate accuracy and other metrics\n",
    "modelEvaluation(\"Decision Tree\", y_test, predict, 0)"
   ]
  },
