    "#displaying failed and successful jobs in different scheduling schemes\n",
    "success = dataset.loc[dataset['failed'] == 0]\n",
    "failed = dataset.loc[dataset['failed'] == 1]\n",
    "success = success.groupby(['scheduling_class'])['failed'].count().reset_index(name=\"Successful Jobs\")\n",
