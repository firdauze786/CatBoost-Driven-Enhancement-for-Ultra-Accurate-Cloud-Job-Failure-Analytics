  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "26071977",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "\n",
      "text/plain": [
       "<Figure size 800x300 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#Distribution of Both Failed & Successful Jobs Across Eight Google Clusters\n",
    "data = dataset.groupby([\"cluster\",'failed'])['failed'].size().reset_index(name='Count')\n",
    "data.loc[data[\"failed\"] == 0, \"failed\"] = \"Success\"\n",
    "data.loc[data[\"failed\"] == 1, \"failed\"] = \"Failed\"\n",
    "plt.figure(figsize=(8, 3))\n",
    "sns.barplot(x='cluster', y='Count', hue='failed', data=data)\n",
    "plt.title(\"Distribution of Both Failed & Successful Jobs Across Eight Google Clusters\")\n",
    "plt.xlabel('Cluster No')\n",
    "plt.ylabel('Job Count')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "3f79ef47",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "\n",
      "text/plain": [
       "<Figure size 800x300 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "#Distribution of Both Failed & Successful Jobs Across scheduling_class\n",
    "data = dataset.groupby([\"scheduling_class\",'failed'])['failed'].size().reset_index(name='Count')\n",
    "data.loc[data[\"failed\"] == 0, \"failed\"] = \"Success\"\n",
    "data.loc[data[\"failed\"] == 1, \"failed\"] = \"Failed\"\n",
    "plt.figure(figsize=(8, 3))\n",
    "sns.barplot(x='scheduling_class', y='Count', hue='failed', data=data)\n",
    "plt.title(\"Distribution of Both Failed & Successful Jobs Across Different Scheduling Class\")\n",
    "plt.xlabel('Scheduling Class')\n",
    "plt.ylabel('Job Count')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
